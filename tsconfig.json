{
  "compilerOptions": {
    "rootDir": ".",
    "outDir": "./dist",

    "target": "es2020",

    "module": "commonjs",
    "moduleResolution": "node",

    "ignoreDeprecations": "6.0",

    "types": [
      "node",
      "jest"
    ],

    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },

  "include": [
    "src",
    "tests"
  ]
}