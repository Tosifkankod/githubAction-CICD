{
  "compilerOptions": {
    "rootDir": "src",
    "outDir": "./dist",

    "target": "es2020",

    "module": "ESNext",
    "moduleResolution": "node",

    "ignoreDeprecations": "6.0",

    "types": [
      "node",
      "jest"
    ],

    "sourceMap": true,
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true
  },

  "include": [
    "src/**/*"
  ],
  "exclude": ["node_modules", "dist", "tests"]
}